/**
 * @brief Provide an overview of the purpose and functionality of the peripheral: crg_cfg (CRGCFG)
 */
#ifdef __cplusplus
#define   __I        volatile          /*!< Defines 'read only' permissions */
#else
#define   __I        volatile const    /*!< Defines 'read only' permissions */
#endif
#define     __O      volatile          /*!< Defines 'write only' permissions */
#define     __IO     volatile          /*!< Defines 'read / write' permissions */

/* following defines should be used for structure members */
#define     __IM     volatile const      /*! Defines 'read only' structure member permissions */
#define     __OM     volatile            /*! Defines 'write only' structure member permissions */
#define     __IOM    volatile            /*! Defines 'read / write' structure member permissions */

static void SystemClock_Config(void)
{
    CRG_unlockClockConfig();
    /* Configure PLL */
    if (CRG_setPLLConfig((const CRG_PLLConfigParam *)&pllInit, HSXO_VALUE, PLLLOCK_TIMEOUT) == DRV_OK)
    {
        /* Configure CPU, BUS, Peripherals Clock  dividers  */
        if (CRG_setClockDivConfig((const CRG_ClockConfigParam *)&clkInit) != DRV_OK)
        {
            while (1);
        }
        /* Select PLL Fout Source */
        if (CRG_setClockOutSource(CRG_CLKSRC_PLL_FOUT) != DRV_OK)
        {
            while (1);
        }
    }
    else
    {
        while (1);
    }
    CRG_lockClockConfig();
}

/**
 * @brief PFlash and DFlash Timing trim param load  depend on FLash Clock
 *  when efc clk switch to higher clock,  trim load first, then switch efc clk(tck_len_trc, tMS, tRC, tACC)
 *  when efc clk switch to lower clock,  switch efc clc, then load timing trim(tMS, tACC, tRC, tck_len_trc)
 * @param level  FLASH_FRQ_25M_LVL, FLASH_FRQ_50M_LVL, FLASH_FRQ_75M_LVL, FLASH_FRQ_100M_LVL
 */
static void SystemFlash_TrimLoadSF(uint8_t level)
{
    uint32_t reg_tmp = 0;

    if (level > FLASH_FRQ_100M_LVL)
    {
        return;
    }
    /* unlock reg */
    if (READ_BIT(DFLASH->EFC_WPFLG, DFLASH_EFC_WPFLG_EFC_REG_WRPROT_FLG_Msk))
    {
        /* unlock */
        DFLASH->EFC_REG_KEY1 = 0x0123CDEF;
        DFLASH->EFC_REG_KEY2 = 0x89AB4567;
        /* wait clear */
        while (READ_BIT(DFLASH->EFC_WPFLG, DFLASH_EFC_WPFLG_EFC_REG_WRPROT_FLG_Msk));
    }

    reg_tmp |= (flashTrimParam[level][23] << DFLASH_EFC_TIMING_PARA8_EFC_TSCE_Pos)
               & DFLASH_EFC_TIMING_PARA8_EFC_TSCE_Msk;
    reg_tmp |= (flashTrimParam[level][27] << DFLASH_EFC_TIMING_PARA8_EFC_TCK_LE_TRC_Pos)
               & DFLASH_EFC_TIMING_PARA8_EFC_TCK_LE_TRC_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA8 = reg_tmp;


    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][7] << DFLASH_EFC_TIMING_PARA12_EFC_TMS_Pos)
               & DFLASH_EFC_TIMING_PARA12_EFC_TMS_Msk;
    reg_tmp |= (flashTrimParam[level][8] << DFLASH_EFC_TIMING_PARA12_EFC_TMH_Pos)
               & DFLASH_EFC_TIMING_PARA12_EFC_TMH_Msk;

    MODIFY_REG(DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA12,
               DFLASH_EFC_TIMING_PARA12_EFC_TMS_Msk | DFLASH_EFC_TIMING_PARA12_EFC_TMH_Msk, reg_tmp);

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][0] << DFLASH_EFC_TIMING_PARA0_EFC_TRC_0_Pos)
               & DFLASH_EFC_TIMING_PARA0_EFC_TRC_0_Msk;
    reg_tmp |= (flashTrimParam[level][1] << DFLASH_EFC_TIMING_PARA0_EFC_TRC_1_Pos)
               & DFLASH_EFC_TIMING_PARA0_EFC_TRC_1_Msk;
    reg_tmp |= (flashTrimParam[level][2] << DFLASH_EFC_TIMING_PARA0_EFC_TWFH_Pos)
               & DFLASH_EFC_TIMING_PARA0_EFC_TWFH_Msk;
    reg_tmp |= (flashTrimParam[level][3] << DFLASH_EFC_TIMING_PARA0_EFC_TCFL_Pos)
               & DFLASH_EFC_TIMING_PARA0_EFC_TCFL_Msk;
    reg_tmp |= (flashTrimParam[level][4] << DFLASH_EFC_TIMING_PARA0_EFC_TCONFEN_Pos)
               & DFLASH_EFC_TIMING_PARA0_EFC_TCONFEN_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA0 = reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][5] << DFLASH_EFC_TIMING_PARA12_EFC_TACC_0_Pos)
               & DFLASH_EFC_TIMING_PARA12_EFC_TACC_0_Msk;
    reg_tmp |= (flashTrimParam[level][6] << DFLASH_EFC_TIMING_PARA12_EFC_TACC_1_Pos)
               & DFLASH_EFC_TIMING_PARA12_EFC_TACC_1_Msk;

    MODIFY_REG(DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA12,
               DFLASH_EFC_TIMING_PARA12_EFC_TACC_0_Msk | DFLASH_EFC_TIMING_PARA12_EFC_TACC_1_Msk, reg_tmp);

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][9] << DFLASH_EFC_TIMING_PARA1_EFC_TNVS_Pos)
               & DFLASH_EFC_TIMING_PARA1_EFC_TNVS_Msk;
    reg_tmp |= (flashTrimParam[level][10] << DFLASH_EFC_TIMING_PARA1_EFC_TPREP_Pos)
               & DFLASH_EFC_TIMING_PARA1_EFC_TPREP_Msk;
    reg_tmp |= (flashTrimParam[level][12] << DFLASH_EFC_TIMING_PARA1_EFC_TADS_Pos)
               & DFLASH_EFC_TIMING_PARA1_EFC_TADS_Msk;
    reg_tmp |= (flashTrimParam[level][13] << DFLASH_EFC_TIMING_PARA1_EFC_TADH_Pos)
               & DFLASH_EFC_TIMING_PARA1_EFC_TADH_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA1 = reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][11] << DFLASH_EFC_TIMING_PARA2_EFC_TPROG_Pos)
               & DFLASH_EFC_TIMING_PARA2_EFC_TPROG_Msk;
    reg_tmp |= (flashTrimParam[level][14] << DFLASH_EFC_TIMING_PARA2_EFC_TPGS_Pos)
               & DFLASH_EFC_TIMING_PARA2_EFC_TPGS_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA2 = reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][15] << DFLASH_EFC_TIMING_PARA3_EFC_TPGH_Pos)
               & DFLASH_EFC_TIMING_PARA3_EFC_TPGH_Msk;
    reg_tmp |= (flashTrimParam[level][16] << DFLASH_EFC_TIMING_PARA3_EFC_TPREPGS_Pos)
               & DFLASH_EFC_TIMING_PARA3_EFC_TPREPGS_Msk;
    reg_tmp |= (flashTrimParam[level][17] << DFLASH_EFC_TIMING_PARA3_EFC_TPREPGH_Pos)
               & DFLASH_EFC_TIMING_PARA3_EFC_TPREPGH_Msk;
    reg_tmp |= (flashTrimParam[level][24] << DFLASH_EFC_TIMING_PARA3_EFC_TRW_Pos)
               & DFLASH_EFC_TIMING_PARA3_EFC_TRW_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA3 = reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][18] << DFLASH_EFC_TIMING_PARA4_EFC_TRCV_0_Pos)
               & DFLASH_EFC_TIMING_PARA4_EFC_TRCV_0_Msk;
    reg_tmp |= (flashTrimParam[level][20] << DFLASH_EFC_TIMING_PARA4_EFC_TRCV_2_Pos)
               & DFLASH_EFC_TIMING_PARA4_EFC_TRCV_2_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA4 = reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][19] << DFLASH_EFC_TIMING_PARA5_EFC_TRCV_1_Pos)
               & DFLASH_EFC_TIMING_PARA5_EFC_TRCV_1_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA5 = reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][21] << DFLASH_EFC_TIMING_PARA6_EFC_TERASE_0_Pos)
               & DFLASH_EFC_TIMING_PARA6_EFC_TERASE_0_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA6 = reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][22] << DFLASH_EFC_TIMING_PARA7_EFC_TERASE_1_Pos)
               & DFLASH_EFC_TIMING_PARA7_EFC_TERASE_1_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA7 = reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][25] << DFLASH_EFC_TIMING_PARA9_EFC_TDPDSR_Pos)
               & DFLASH_EFC_TIMING_PARA9_EFC_TDPDSR_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA9 &= ~DFLASH_EFC_TIMING_PARA9_EFC_TDPDSR_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA9 |= reg_tmp;

    reg_tmp  = 0;
    reg_tmp |= (flashTrimParam[level][26] << DFLASH_EFC_TIMING_PARA11_EFC_TDPDH_Pos)
               & DFLASH_EFC_TIMING_PARA11_EFC_TDPDH_Msk;
    DFLASH->EFC_DFLASH_EXTEND.EFC_TIMING_PARA11 = reg_tmp;

    /* lock reg */
    SET_BIT(DFLASH->EFC_WPFLG, DFLASH_EFC_WPFLG_EFC_REG_WRPROT_FLG_Msk);
}

